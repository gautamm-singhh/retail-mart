FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too

# Defaults to a local SQLite file if unset. Point this at MySQL to match
# the production ERD, e.g.:
# DATABASE_URL=mysql+pymysql://retail_mart:password@localhost:3306/retail_mart
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/retail_mart

# Comma-separated list of allowed origins for the frontend dev server(s)
CORS_ORIGINS=http://localhost:5173

PORT=4000

# --- Optional: Week 3 features -------------------------------------
# All of these are optional. Leave unset and everything still works:
# emails log to the console, RazorPay checkout runs against a mock, and
# AI projections fall back to a templated statistical summary.

# --- Email Configurations (Three Senders) ------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SUPPORT_USERNAME=
SMTP_SUPPORT_PASSWORD=
SMTP_ORDERS_USERNAME=
SMTP_ORDERS_PASSWORD=
SMTP_MARKETING_USERNAME=
SMTP_MARKETING_PASSWORD=
MAIL_SUPPORT_FROM=
MAIL_ORDERS_FROM=
MAIL_MARKETING_FROM=

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
